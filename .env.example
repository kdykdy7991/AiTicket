# docker-compose.prod.yml 配置 —— 复制本文件为 .env 并按需修改
# 本地起：WEB_PORT 填 8003（避开本机已占端口）；其他机器填任意可用端口

# 团队访问端口
WEB_PORT=8003

# POC 基础设施端口（仅监听本机，避免与原 skdy_prod 冲突）
DB_PORT=5433
LOKI_PORT=3101

# 数据库
POSTGRES_USER=skdy
POSTGRES_PASSWORD=skdy123
POSTGRES_DB=skdy_ticket

# JWT 密钥（生产请改成自己的随机串）
JWT_SECRET_KEY=06de41eace564953fa12dbf54c886fadd90e5865727931ff05da23bb3fe5e172

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
