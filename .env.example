# docker-compose.prod.yml 配置 —— 复制本文件为 .env 并按需修改
# 本机 8003 属于 skdy-poc；工单生产 Compose 请使用空闲端口

# 团队访问端口
WEB_PORT=8004

# 数据库
POSTGRES_USER=skdy
POSTGRES_PASSWORD=skdy123
POSTGRES_DB=skdy_ticket

# JWT 密钥（生产请改成自己的随机串）
JWT_SECRET_KEY=06de41eace564953fa12dbf54c886fadd90e5865727931ff05da23bb3fe5e172

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# MCP：分别给 Agent 平台和 MCP→API 内部调用使用，务必填不同的随机值。
MCP_BEARER_TOKEN=
MCP_INTERNAL_TOKEN=
# 开发环境按需填写，例如 10.113.114.88:*
MCP_ALLOWED_HOSTS=

# Debussy Embed：应用需设为“受信任系统”，并签发本系统专用凭据。
AGENT_EMBED_URL=
AGENT_EMBED_API_URL=
AGENT_EMBED_CLIENT_ID=
AGENT_EMBED_CLIENT_SECRET=

# Casdoor OIDC：先在 Casdoor 创建“客服工单系统”应用并登记回调地址。
# 开发环境建议使用 10.113.114.88:18000，浏览器与 API 容器均可访问。
CASDOOR_ISSUER=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
# 逗号分隔，回调路径固定为 /auth/casdoor/callback。
CASDOOR_REDIRECT_ORIGINS=http://localhost:5173

# RAG Server：凭证仅保存在工单后端。配置后使用真实知识库代理。
RAG_API_URL=http://10.113.114.88:8770
RAG_SERVICE_TOKEN=
